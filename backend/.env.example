# Optional credentials. Public repository analysis works without these.
GITHUB_TOKEN=
GEMINI_API_KEY=
TOKENHARBOR_API_KEY=

# Local defaults are also supplied by docker-compose.yml.
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=analyzer_secret
POSTGRES_DB=github_analyzer
RATE_LIMIT_PER_MINUTE=30
APP_SECRET_KEY=
CORS_ORIGINS=http://localhost:4200,http://localhost:5173
